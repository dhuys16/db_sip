# Salin file ini jadi .env lalu isi sesuai environment kamu (jangan commit .env).

# Server
PORT=8080

# Database (MySQL) - dipakai config/database.go
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_sip

# Auth admin (JWT) - dipakai middleware auth, belum diimplementasi
JWT_SECRET=

# Midtrans - dipakai webhook & pembuatan transaksi, belum diimplementasi
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
